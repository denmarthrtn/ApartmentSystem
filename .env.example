# Copy to .env (which git ignores) and fill in. Used by docker compose only.

# SQL Server "sa" password: at least 8 characters with upper, lower, digit and symbol. Don't use ";".
SQL_SA_PASSWORD=

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=

# Optional: your own admin account (the demo accounts are created either way)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
